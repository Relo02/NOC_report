\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces The hybrid barrier~\eqref  {eq:barrier} for four steepness values ($W_{\mathrm  {obs}}=50$, $r_{\mathrm  {obs}}=0.45$~m): value (left), gradient (centre) and curvature (right) versus clearance. The sigmoid alone saturates and loses its gradient inside the obstacle; the quadratic term restores an unbounded, linearly growing restoring force for $d<r_{\mathrm  {obs}}$. The curvature grows as $\alpha _{\mathrm  {obs}}^2$, which is what degrades the conditioning of the NLP.}}{13}{figure.caption.39}\protected@file@percent }
\newlabel{fig:barriershape}{{7}{13}{The hybrid barrier~\eqref {eq:barrier} for four steepness values ($\Wobs =50$, $\robs =0.45$~m): value (left), gradient (centre) and curvature (right) versus clearance. The sigmoid alone saturates and loses its gradient inside the obstacle; the quadratic term restores an unbounded, linearly growing restoring force for $d<\robs $. The curvature grows as $\aobs ^2$, which is what degrades the conditioning of the NLP}{figure.caption.39}{}}
\newlabel{fig:barriershape@cref}{{[figure][7][]7}{[1][13][]13}}
