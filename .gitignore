# ---------------------------------------------------------------------------
# LaTeX build artifacts — regenerated by pdflatex / bibtex / latexmk on every
# compile. Tracking them makes every co-authored build a merge conflict.
# The compiled Report.pdf is deliberately NOT ignored: it is the deliverable.
# ---------------------------------------------------------------------------
*.aux
*.bbl
*.bcf
*.blg
*.brf
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.log
*.lot
*.nav
*.out
*.run.xml
*.snm
*.toc
*.vrb
*.xdv
*.synctex.gz
*.synctex(busy)

# epstopdf output: regenerated from the tracked .eps sources
*-eps-converted-to.pdf

# ---------------------------------------------------------------------------
# Editor and OS noise
# ---------------------------------------------------------------------------
*~
.DS_Store
.vscode/
